*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.sch-bak
*.brd-bak
*.bak
*.lck
*.tmp
fp-info-cache
_autosave-*

# ------------------------------------------------------------------------------
